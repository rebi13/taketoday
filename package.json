{
  "name": "taketoday",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --passWithNoTests",
    "seed:validate": "tsx seed/validate.ts",
    "db:generate": "NODE_OPTIONS=--conditions=react-server drizzle-kit generate",
    "db:migrate": "NODE_OPTIONS=--conditions=react-server drizzle-kit migrate",
    "db:seed": "NODE_OPTIONS=--conditions=react-server tsx src/server/db/seed/run.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "1.11.3",
    "@date-fns/tz": "1.5.0",
    "@neondatabase/serverless": "1.2.0",
    "@vercel/functions": "3.10.5",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.57.0",
    "next": "16.4.3",
    "next-auth": "5.0.0-beta.32",
    "pretendard": "1.3.9",
    "radix-ui": "1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "shadcn": "4.21.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "@electric-sql/pglite": "^0.5.14",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-boundaries": "^7.4.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22"
  }
}
