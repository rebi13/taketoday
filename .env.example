# 로컬 개발용 환경변수 예시. `cp .env.example .env.local` 후 값을 채운다.
# 값을 어디서 받는지는 docs/setup.md를 본다. .env.local은 git에 올리지 않는다.

# Neon dev 브랜치 — 풀링 연결 (Connect 화면에서 Connection pooling 켬)
DATABASE_URL=
# Neon dev 브랜치 — 직접 연결 (Connection pooling 끔). drizzle-kit 마이그레이션용
DATABASE_URL_UNPOOLED=

# Auth.js — `pnpm dlx auth secret` 또는 `openssl rand -base64 33`
AUTH_SECRET=
# Google Cloud > Google Auth Platform > 클라이언트
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
